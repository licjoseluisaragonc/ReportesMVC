@model ReportesMVC.Models.EntLoginDTO
@{
    ViewData["Title"] = "Login";
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: calc(100vh - 140px);">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <div class="mb-2">
                            <span class="badge bg-primary rounded-pill px-3 py-2">ReportesMVC</span>
                        </div>
                        <h3 class="fw-bold mb-1">Bienvenido</h3>
                        <div class="text-muted">Ingresa tus credenciales</div>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small" role="alert">
                            @ViewBag.Error
                        </div>
                    }

                    @Html.ValidationSummary(false, "", new { @class = "alert alert-warning small" })

                    <form asp-action="Login" asp-controller="Accesos" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="userAccess" class="form-label fw-semibold"></label>
                            <input asp-for="userAccess" class="form-control form-control-lg" autocomplete="username" />
                            <span asp-validation-for="userAccess" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="passwordAccess" class="form-label fw-semibold"></label>
                            <input asp-for="passwordAccess" class="form-control form-control-lg" autocomplete="current-password" />
                            <span asp-validation-for="passwordAccess" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold">
                                Entrar
                            </button>
                        </div>

                        <div class="text-center mt-4">
                            <div class="text-muted small">© @DateTime.Now.Year · ReportesMVC</div>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
